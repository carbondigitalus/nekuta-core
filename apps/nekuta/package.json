{
    "name": "@nekuta/core",
    "version": "0.0.1",
    "private": false,
    "license": "MIT",
    "description": "A React store ecosystem based on Vue's Pinia store.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b -v",
        "test:unit": "jest --coverage --passWithNoTests --config jest.config.ts",
        "test:watch": "jest --coverage --watch --passWithNoTests --config jest.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@nekuta/jest-config": "file:../../packages/jest-config",
        "@nekuta/typescript-config": "*",
        "@types/jest": "^30.0.0",
        "@types/react": "19.1.11",
        "@types/react-dom": "19.1.7",
        "jest": "^30.1.3",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "ts-jest": "^29.4.4",
        "typescript": "^5.9.2"
    }
}
