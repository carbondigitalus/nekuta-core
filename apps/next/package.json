{
    "name": "@nekuta/next",
    "version": "0.1.0-alpha.0",
    "private": false,
    "license": "MIT",
    "description": "Next.js adapter for Nekuta — SSR/hydration support for the Pages Router and App Router.",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b -v tsconfig.build.json",
        "test:unit": "jest --coverage --passWithNoTests --config jest.config.ts",
        "test:watch": "jest --coverage --watch --passWithNoTests --config jest.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "@nekuta/core": "*",
        "next": "^15.0.0 || ^16.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@nekuta/core": "file:../nekuta",
        "@nekuta/jest-config": "file:../../packages/jest-config",
        "@nekuta/typescript-config": "*",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/react": "19.1.11",
        "@types/react-dom": "19.1.7",
        "jest": "^30.1.3",
        "jest-environment-jsdom": "^30.2.0",
        "next": "^15.5.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "ts-jest": "^29.4.4",
        "typescript": "^5.9.2"
    }
}
