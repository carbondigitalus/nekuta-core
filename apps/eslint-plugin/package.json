{
    "name": "@nekuta/eslint-plugin",
    "version": "0.1.0",
    "private": false,
    "license": "MIT",
    "description": "ESLint rules for Nekuta — enforce a single defineStore() authoring style across a project.",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b -v tsconfig.build.json",
        "test:unit": "jest --coverage --passWithNoTests --config jest.config.ts",
        "test:watch": "jest --coverage --watch --passWithNoTests --config jest.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "eslint": "^9.0.0"
    },
    "devDependencies": {
        "@nekuta/jest-config": "file:../../packages/jest-config",
        "@nekuta/typescript-config": "*",
        "@types/estree": "*",
        "@types/jest": "^30.0.0",
        "eslint": "^9.34.0",
        "jest": "^30.1.3",
        "ts-jest": "^29.4.4",
        "typescript": "^5.9.2"
    }
}
