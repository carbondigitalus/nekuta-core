{
    "name": "@nekuta/jest-config",
    "version": "0.0.0",
    "private": true,
    "license": "UNLICENSED",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./nest": {
            "import": "./dist/nest.js",
            "require": "./dist/nest.js",
            "types": "./dist/nest.d.ts"
        },
        "./next": {
            "import": "./dist/next.js",
            "require": "./dist/next.js",
            "types": "./dist/next.d.ts"
        },
        "./node": {
            "import": "./dist/node.js",
            "require": "./dist/node.js",
            "types": "./dist/node.d.ts"
        }
    },
    "devDependencies": {
        "@jest/types": "^30.0.5",
        "@types/jest": "^30.0.0",
        "@nekuta/typescript-config": "*",
        "jest": "^30.1.3",
        "next": "^15.5.0",
        "ts-jest": "^29.4.4",
        "typescript": "^5.9.2"
    }
}
