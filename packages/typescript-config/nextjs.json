{
    "extends": "./base.json",
    "compilerOptions": {
        "plugins": [{ "name": "next" }],
        "allowJs": true,
        "jsx": "preserve",
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "incremental": true
    }
}
