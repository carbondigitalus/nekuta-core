{
    "name": "@nekuta/eslint-config",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "exports": {
        "./base": {
            "types": "./src/base.d.ts",
            "default": "./src/base.mjs"
        },
        "./nest-js": {
            "types": "./src/nest.d.ts",
            "default": "./src/nest.mjs"
