        "./next-js": {
            "types": "./src/next.d.ts",
            "default": "./src/next.mjs"
        }
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@typescript-eslint/eslint-plugin": "^8.40.0",
        "@typescript-eslint/parser": "^8.40.0",
        "eslint": "^9.34.0",
        "eslint-config-next": "15.5.7",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4"
    }
}
