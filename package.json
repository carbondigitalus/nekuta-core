{
    "name": "nekuta-core",
    "version": "0.1.0",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "turbo build",
        "build:docs": "npx turbo run build --filter=@nekuta/docs",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "lint": "turbo lint",
        "start:dev": "turbo start:dev",
        "test:e2e": "turbo test:e2e",
        "test:unit": "turbo test:unit",
        "typecheck": "turbo typecheck"
    },
    "devDependencies": {
        "prettier": "^3.6.2",
        "turbo": "^2.10.9"
    },
    "packageManager": "npm@11.13.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "overrides": {
        "react": "19.1.1",
        "react-dom": "19.1.1"
    },
    "allowScripts": {
        "@sentry/cli": true,
        "argon2": true,
        "sharp": true,
        "esbuild": true,
        "core-js": true,
        "@heroui/shared-utils": true,
        "unrs-resolver": true,
        "@parcel/watcher": true
    }
}
